# Karan's digital twin — backend env vars.
# Copy to .env for local dev; set the same keys in Vercel → Project → Settings → Environment Variables.

# Google AI Studio API key — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Secret salt for one-way IP hashing in rate limiting. Any long random string.
IP_HASH_SALT=

# Upstash Redis (REST). Names match the Vercel → Upstash integration when its
# connection prefix is "KV". Values come from the Upstash console (REST API tab).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Umami Cloud — collects the custom events (Vercel Web Analytics only does that
# on Pro; it still handles page views). Website ID from cloud.umami.is →
# Settings → Websites → Edit. Leave blank locally so dev traffic stays out of
# the numbers. NEXT_PUBLIC_ vars are inlined at build time, so set this in
# Vercel BEFORE the build that should start reporting.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Optional overrides (defaults shown):
# NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
# GEMINI_MODEL=gemini-2.5-flash-lite
# ALLOWED_ORIGIN=https://karankh.tech
# RL_PER_MIN=8
# RL_PER_DAY=40
# DAILY_BUDGET=500
